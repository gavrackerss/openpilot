try:
  import libusb
except ImportError:
  libusb = None

Import('env', 'common', 'messaging')

panda_env = env.Clone()
if libusb is not None:
  panda_env.Append(CPPPATH=[libusb.INCLUDE_DIR], LIBPATH=[libusb.LIB_DIR])

libs = ['usb-1.0', common, messaging, 'pthread']
panda = panda_env.Library('panda', ['panda.cc', 'panda_comms.cc', 'spi.cc'])

panda_env.Program('pandad', ['main.cc', 'pandad.cc', 'panda_safety.cc'], LIBS=[panda] + libs)

if GetOption('extras'):
  panda_env.Program('tests/test_pandad_usbprotocol', ['tests/test_pandad_usbprotocol.cc'], LIBS=[panda] + libs)
