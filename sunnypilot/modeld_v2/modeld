#!/usr/bin/env bash
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null && pwd)"
ROOT="$(cd "$DIR/../.." >/dev/null && pwd)"
export PYTHONPATH="$ROOT/sunnypilot/third_party/tinygrad_repo:$ROOT/tinygrad_repo:$ROOT:${PYTHONPATH:-}"

# XNOR: supervise modeld so manager never leaves the Python Tinygrad child
# behind on an onroad -> offroad transition. Background jobs can inherit
# SIGINT ignored, so manager's SIGINT must be translated to SIGTERM here.
child_pid=""
stopping=0

child_running() {
  [ -n "${child_pid:-}" ] || return 1
  kill -0 "$child_pid" 2>/dev/null || return 1

  # A zombie is already dead and only needs to be reaped. kill -0 can still
  # succeed for zombies, so explicitly treat Z as not running.
  if [ -r "/proc/$child_pid/stat" ]; then
    local _pid _comm state _rest
    read -r _pid _comm state _rest < "/proc/$child_pid/stat" || return 1
    [ "$state" != "Z" ] || return 1
  fi
  return 0
}

shutdown_child() {
  stopping=1

  if child_running; then
    echo "XNOR_MODEL_SELECTOR: stopping modeld child PID ${child_pid}" >&2
    kill -TERM "$child_pid" 2>/dev/null || true

    # Stay well inside manager's 5 second shutdown grace period.
    for _ in $(seq 1 20); do
      child_running || break
      sleep 0.1
    done

    # Never permit a Tinygrad child to survive after the wrapper is stopped.
    if child_running; then
      echo "XNOR_MODEL_SELECTOR: modeld child PID ${child_pid} did not exit after SIGTERM; sending SIGKILL" >&2
      kill -KILL "$child_pid" 2>/dev/null || true
    fi
  fi

  # Reap the child if it has exited/zombied. Ignore its status because this is
  # an intentional manager shutdown, not a model failure.
  if [ -n "${child_pid:-}" ]; then
    wait "$child_pid" 2>/dev/null || true
  fi

  child_pid=""
  exit 0
}

trap shutdown_child INT TERM

python3 "$DIR/modeld.py" "$@" &
child_pid=$!

# Normal runtime: wait for a genuine model exit. SIGINT/SIGTERM invokes the
# trap above, which terminates and reaps the child before this shell exits.
wait "$child_pid"
rc=$?
child_pid=""
trap - INT TERM

# A genuine custom-model failure still falls back to stock modeld.
if [ "$stopping" -eq 0 ] && [ "$rc" -ne 0 ]; then
  echo "XNOR_MODEL_SELECTOR: custom modeld failed (rc=$rc); reverting active bundle and falling back to stock modeld" >&2
  python3 - <<'PY2'
from openpilot.common.params import Params
p = Params()
p.remove("ModelManager_ActiveBundle")
p.remove("ModelRunnerTypeCache")
PY2
  exec python3 "$ROOT/selfdrive/modeld/modeld.py" "$@"
fi

exit 0
