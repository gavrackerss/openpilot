#!/usr/bin/env bash
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null && pwd)"
ROOT="$(cd "$DIR/../.." >/dev/null && pwd)"
export PYTHONPATH="$ROOT/sunnypilot/third_party/tinygrad_repo:$ROOT/tinygrad_repo:$ROOT:${PYTHONPATH:-}"

# XNOR: supervise modeld so the manager-owned wrapper cannot leave a Tinygrad
# Python child behind when transitioning offroad. A background child can inherit
# SIGINT ignored from bash, so always terminate it with SIGTERM instead of
# forwarding manager's SIGINT verbatim.
child_pid=""
stopping=0

shutdown_child() {
  stopping=1

  if [ -n "${child_pid:-}" ] && kill -0 "$child_pid" 2>/dev/null; then
    echo "XNOR_MODEL_SELECTOR: stopping modeld child PID ${child_pid}" >&2
    kill -TERM "$child_pid" 2>/dev/null || true

    # Stay inside manager's 5 second shutdown window while allowing Python to
    # unwind normally first.
    deadline=$((SECONDS + 2))
    while kill -0 "$child_pid" 2>/dev/null && [ "$SECONDS" -lt "$deadline" ]; do
      sleep 0.1
    done

    # Never permit modeld_tinygrad to survive as a PPID 1 orphan.
    if kill -0 "$child_pid" 2>/dev/null; then
      echo "XNOR_MODEL_SELECTOR: child PID ${child_pid} did not exit; sending SIGKILL" >&2
      kill -KILL "$child_pid" 2>/dev/null || true
    fi

    wait "$child_pid" 2>/dev/null || true
  fi

  child_pid=""
  exit 0
}

trap shutdown_child INT TERM

python3 "$DIR/modeld.py" "$@" &
child_pid=$!

# A natural child exit means either a clean model exit or a real failure.
# Intentional manager shutdown never reaches this path because shutdown_child
# exits after reaping the child.
wait "$child_pid"
rc=$?
child_pid=""
trap - INT TERM

if [ "$stopping" -ne 0 ]; then
  exit 0
fi

if [ "$rc" -ne 0 ]; then
  echo "XNOR_MODEL_SELECTOR: custom modeld failed (rc=$rc); reverting active bundle and falling back to stock modeld" >&2
  python3 - <<'PY2'
from openpilot.common.params import Params
p = Params()
p.remove("ModelManager_ActiveBundle")
p.remove("ModelRunnerTypeCache")
PY2
  exec python3 "$ROOT/selfdrive/modeld/modeld.py" "$@"
fi

exit 0
